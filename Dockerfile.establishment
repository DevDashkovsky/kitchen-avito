# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/establishment ./cmd/establishment

FROM alpine:3.23

COPY --from=builder /out/establishment /establishment

USER 65532:65532

ENTRYPOINT ["/establishment"]
