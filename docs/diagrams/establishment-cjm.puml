@startuml
title CJM заведения в Авито.Кухне

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #ECF9EE
  BorderColor #3E7C45
  FontColor #1F2937
}

start

partition "1. Подключение" {
  :Заведение получает доступ
  к Авито.Кухне;
  :Проверяет, что интеграция
  с платформой работает;
}

partition "2. Управление меню" {
  :Добавляет категории
  и позиции меню;
  :Обновляет названия, описания,
  цены и доступность блюд;
  :Управляет доступностью
  приёма новых заказов;
}

partition "3. Получение заказа" {
  :Заведение получает новый заказ;

  if (Покупатель уже отменил заказ?) then (да)
    :Заведение видит,
    что заказ уже отменён;
    stop
  else (нет)
    :Проверяет состав заказа
    и данные доставки;
    :Принимает решение
    в течение двух минут;
  endif

  if (Заведение успело ответить?) then (да)
  else (нет)
    :Авито.Кухня завершает ожидание;
    :Заказ отклонён по таймауту;
    :Подтвердить его нельзя;
    :Повтор отказа возвращает
    сохранённую причину таймаута;
    stop
  endif
}

partition "4. Решение по заказу" {
  if (Заказ можно выполнить?) then (да)
    :Заведение подтверждает заказ;
  else (нет)
    :Заведение отклоняет заказ
    и указывает причину;
    stop
  endif
}

partition "5. Выполнение заказа" {
  :Ведёт заказ от подтверждения
  через приготовление к готовности;
  if (До передачи в доставку возникла проблема?) then (да)
    :Отправляет отказ
    с обязательной причиной;
    if (Передача в доставку уже опередила отказ?) then (да)
      :Получает конфликт;
      :Продолжает доставку;
    else (нет)
      :Заказ завершён отказом;
      :Покупатель увидит причину;
      stop
    endif
  else (нет)
    :Передаёт заказ в доставку;
  endif
  :Отмечает завершение заказа
  после доставки покупателю;
}

stop
@enduml
