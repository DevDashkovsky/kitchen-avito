@startuml
title CJM покупателя Авито.Кухни

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #E8F1FF
  BorderColor #3567A8
  FontColor #1F2937
}

start

partition "1. Поиск" {
  :Покупатель открывает страницу
  со списком доступных заведений;
  :Ищет заведение или блюдо по названию;
  :Открывает меню выбранного заведения;
}

partition "2. Выбор блюд" {
  :Просматривает категории,
  описания, цены и доступность;
  :Добавляет доступные блюда в корзину;
  :Проверяет состав корзины
  и итоговую стоимость;
}

partition "3. Оформление" {
  :Указывает имя, телефон
  и адрес доставки;
  :При необходимости добавляет
  комментарий к заказу;
  :Подтверждает оформление;
  :Авито.Кухня проверяет состав заказа,
  актуальные цены и доступность блюд;

  if (Данные заказа актуальны?) then (да)
    :Авито.Кухня создаёт заказ;
  else (нет)
    :Покупатель видит,
    какие позиции изменились;
    :Обновляет корзину;
    :Повторно подтверждает оформление;
    :Авито.Кухня создаёт заказ;
  endif

  :Покупатель получает данные
  для отслеживания заказа;
}

partition "4. Подтверждение заведением" {
  if (Покупатель хочет отменить заказ?) then (да)
    :Покупатель запрашивает отмену;

    if (Заведение уже приняло заказ?) then (да)
      :Покупатель видит,
      что отмена уже недоступна;
      :Покупатель видит,
      что заказ принят;
    else (нет)
      :Покупатель видит,
      что заказ отменён;
      stop
    endif
  else (нет)
    :Покупатель ожидает ответ
    заведения до двух минут;

    if (Заведение ответило вовремя?) then (да)
      if (Заведение приняло заказ?) then (да)
        :Покупатель видит,
        что заказ принят;
      else (нет)
        :Покупатель видит причину,
        по которой заказ не принят;
        stop
      endif
    else (нет)
      :Покупатель видит,
      что заведение не ответило вовремя;
      stop
    endif
  endif
}

partition "5. Приготовление и доставка" {
  :Покупатель отслеживает
  этапы выполнения заказа;
  :Ожидает приготовление и доставку;
  :Получает заказ;
}

stop
@enduml
